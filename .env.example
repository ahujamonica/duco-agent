# Copy to .env and export, or export directly in your shell.
# Local prototype defaults are used when a value is absent.

# Database. SQLite by default; use a PostgreSQL URL for a real deployment.
# DUCO_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/duco

# Where uploads and generated reports live (default: ./data)
# DUCO_DATA_DIR=/var/lib/duco

# Required before exposing the app beyond localhost.
# DUCO_JWT_SECRET=replace-with-a-long-random-secret
# DUCO_TOKEN_TTL_HOURS=12

# Demo seeding is available in this prototype. Set to 0 and remove/deny
# POST /api/demo/seed before any real deployment.
DUCO_DEMO_MODE=1
DUCO_ENV=local-prototype

# Optional LLM enrichment (off unless a key is present)
# DUCO_LLM_API_KEY=
# DUCO_LLM_MODEL=gpt-4o-mini
# DUCO_LLM_BASE_URL=https://api.openai.com/v1

# Audio briefing (gTTS needs network; set 0 to always write the script only)
DUCO_TTS=1
